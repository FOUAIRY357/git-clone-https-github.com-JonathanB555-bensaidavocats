---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  titre: string;
  description: string;
  /** Ne pas suffixer le titre (page d'accueil). */
  titreBrut?: boolean;
}

const { titre, description, titreBrut = false } = Astro.props;
const titreComplet = titreBrut ? titre : `${titre} — Taxe sur les Salaires & TVA`;
const urlCanonique = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="fr" class="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={urlCanonique} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urlCanonique} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Taxe sur les Salaires & TVA" />
    <script is:inline>
      // Révèle les pictogrammes une fois la police d'icônes chargée.
      if (document.fonts && document.fonts.load) {
        document.fonts
          .load('24px "Material Symbols Outlined"', 'radar')
          .then(function () {
            document.documentElement.classList.add('icones-chargees');
          })
          .catch(function () {});
      } else {
        document.documentElement.classList.add('icones-chargees');
      }
    </script>
    <slot name="tete" />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Révèle les éléments .reveler à leur entrée dans la fenêtre.
      (function () {
        var elements = document.querySelectorAll('.reveler');
        if (!('IntersectionObserver' in window)) {
          elements.forEach(function (el) { el.classList.add('visible'); });
          return;
        }
        var observateur = new IntersectionObserver(
          function (entrees) {
            entrees.forEach(function (entree) {
              if (entree.isIntersecting) {
                entree.target.classList.add('visible');
                observateur.unobserve(entree.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        elements.forEach(function (el) { observateur.observe(el); });
      })();
    </script>
  </body>
</html>

---
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import PaletteRecherche from '@/components/PaletteRecherche';

interface Props {
  titre: string;
  description: string;
  /** Ne pas suffixer le titre (page d'accueil). */
  titreBrut?: boolean;
  /** Image de partage (chemin absolu du site), héros par défaut. */
  image?: string;
}

const { titre, description, titreBrut = false, image = '/images/accueil-hero.jpg' } = Astro.props;
const titreComplet = titreBrut ? titre : `${titre} · Taxe sur les Salaires & TVA`;
const urlCanonique = new URL(Astro.url.pathname, Astro.site);
const urlImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="fr" class="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={urlCanonique} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urlCanonique} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Taxe sur les Salaires & TVA" />
    <meta property="og:image" content={urlImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titreComplet} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={urlImage} />
    <script is:inline>
      // Révèle les pictogrammes une fois la police d'icônes chargée.
      if (document.fonts && document.fonts.load) {
        document.fonts
          .load('24px "Material Symbols Outlined"', 'radar')
          .then(function () {
            document.documentElement.classList.add('icones-chargees');
          })
          .catch(function () {});
      } else {
        document.documentElement.classList.add('icones-chargees');
      }
    </script>
    <ClientRouter />
    <slot name="tete" />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <PaletteRecherche client:load transition:persist="palette-recherche" />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Initialisations rejouées à chaque navigation (View Transitions).
      document.addEventListener('astro:page-load', function () {
        var mouvementReduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // 0a. Les sections de doctrine se révèlent au défilement
        document.querySelectorAll('.prose-doctrine h2:not(.reveler)').forEach(function (titre) {
          titre.classList.add('reveler');
        });

        // 0b. Barre de progression de lecture (pages qui portent .barre-lecture)
        var barre = document.querySelector('.barre-lecture:not([data-branche])');
        if (barre) {
          barre.dataset.branche = '1';
          var majBarre = function () {
            var total = document.documentElement.scrollHeight - window.innerHeight;
            barre.style.transform = 'scaleX(' + (total > 0 ? Math.min(window.scrollY / total, 1) : 0) + ')';
          };
          window.addEventListener('scroll', majBarre, { passive: true });
          majBarre();
        }

        // 1. Révélation au défilement
        var elements = document.querySelectorAll('.reveler:not(.visible)');
        if (!('IntersectionObserver' in window) || mouvementReduit) {
          elements.forEach(function (el) { el.classList.add('visible'); });
        } else {
          var observateur = new IntersectionObserver(
            function (entrees) {
              entrees.forEach(function (entree) {
                if (entree.isIntersecting) {
                  entree.target.classList.add('visible');
                  observateur.unobserve(entree.target);
                }
              });
            },
            { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
          );
          elements.forEach(function (el) { observateur.observe(el); });
        }

        // 2. Compteurs animés
        var formater = function (valeur, decimales) {
          return valeur.toLocaleString('fr-FR', { minimumFractionDigits: decimales, maximumFractionDigits: decimales });
        };
        var animerCompteur = function (el) {
          var cible = parseFloat(el.dataset.compteur);
          var decimales = parseInt(el.dataset.decimales || '0', 10);
          if (mouvementReduit) { el.textContent = formater(cible, decimales); return; }
          var debut = null;
          var pas = function (t) {
            if (debut === null) debut = t;
            var avancement = Math.min((t - debut) / 1400, 1);
            var facteur = 1 - Math.pow(1 - avancement, 3);
            el.textContent = formater(cible * facteur, decimales);
            if (avancement < 1) requestAnimationFrame(pas);
          };
          requestAnimationFrame(pas);
        };
        var compteurs = document.querySelectorAll('[data-compteur]:not([data-anime])');
        if ('IntersectionObserver' in window && !mouvementReduit) {
          var obsCompteurs = new IntersectionObserver(function (entrees) {
            entrees.forEach(function (entree) {
              if (entree.isIntersecting) {
                entree.target.dataset.anime = '1';
                animerCompteur(entree.target);
                obsCompteurs.unobserve(entree.target);
              }
            });
          }, { threshold: 0.5 });
          compteurs.forEach(function (el) { obsCompteurs.observe(el); });
        } else {
          compteurs.forEach(function (el) { el.dataset.anime = '1'; animerCompteur(el); });
        }

        // 3. Halo doré sous la souris
        document.querySelectorAll('.projecteur').forEach(function (section) {
          section.addEventListener('mousemove', function (e) {
            var boite = section.getBoundingClientRect();
            section.style.setProperty('--sx', (e.clientX - boite.left) + 'px');
            section.style.setProperty('--sy', (e.clientY - boite.top) + 'px');
          });
        });

        // 4. Parallaxe du héros
        var parallaxe = document.querySelector('.parallaxe');
        if (parallaxe && !mouvementReduit) {
          var actif = false;
          window.addEventListener('scroll', function () {
            if (actif) return;
            actif = true;
            requestAnimationFrame(function () {
              if (window.scrollY < window.innerHeight * 1.2) {
                parallaxe.style.transform = 'translate3d(0,' + window.scrollY * 0.22 + 'px,0)';
              }
              actif = false;
            });
          }, { passive: true });
        }

        // 5. Menu mobile
        var bouton = document.getElementById('bouton-menu');
        var menu = document.getElementById('menu-mobile');
        if (bouton && menu && !bouton.dataset.branche) {
          bouton.dataset.branche = '1';
          bouton.addEventListener('click', function () {
            var ouvert = menu.classList.toggle('hidden') === false;
            bouton.setAttribute('aria-expanded', String(ouvert));
          });
        }
      });
    </script>
  </body>
</html>

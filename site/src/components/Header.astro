---
const chemin = Astro.url.pathname;
const estActif = (prefixe: string) => chemin.startsWith(prefixe);

const liens = [
  { href: '/secteurs/', libelle: 'Secteurs' },
  { href: '/actualites/', libelle: 'Actualités' },
  { href: '/expert/', libelle: "L'expert" },
];
---

<header class="sticky top-0 z-40 border-b border-white/10 bg-nuit/90 text-white backdrop-blur">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-5 md:px-10">
    <a href="/" class="flex items-center gap-3" aria-label="Taxe sur les Salaires & TVA — accueil">
      <span class="texte-affiche text-lg leading-none text-white">
        Taxe<span class="text-or-vif">salaire</span>
      </span>
      <span class="hidden border-l border-white/20 pl-3 text-[0.6rem] font-semibold uppercase tracking-[0.18em] text-white/60 sm:block">
        Taxe sur les salaires<br />& TVA
      </span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Navigation principale">
      {
        liens.map((lien) => (
          <a
            href={lien.href}
            class:list={[
              'font-texte text-sm font-medium transition-colors hover:text-white',
              estActif(lien.href) ? 'text-white underline decoration-or-vif decoration-2 underline-offset-8' : 'text-white/70',
            ]}
          >
            {lien.libelle}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <button
        type="button"
        data-ouvrir-recherche
        class="flex items-center gap-2 rounded border border-white/25 px-3 py-2 font-texte text-sm text-white/70 transition-colors hover:border-white/60 hover:text-white"
        aria-label="Recherche rapide"
      >
        <span class="ms text-lg" aria-hidden="true">search</span>
        Rechercher
        <kbd class="rounded border border-white/20 bg-white/10 px-1.5 py-0.5 text-[10px] font-bold text-white/50">⌘K</kbd>
      </button>
      <a
        href="/scan-taxe-salaires/"
        class="rounded border border-white/40 px-4 py-2 font-texte text-sm font-semibold text-white transition-colors hover:border-white hover:bg-white/10"
      >
        Scan Taxe sur les salaires
      </a>
      <a
        href="/scan-tva/"
        class="flex items-center gap-2 rounded bg-or-vif px-4 py-2 font-texte text-sm font-bold text-nuit transition-all hover:-translate-y-0.5 hover:bg-or-pale"
      >
        <span class="ms text-lg" aria-hidden="true">radar</span>
        Scan TVA
      </a>
    </div>

    <div class="flex items-center gap-2 lg:hidden">
      <button
        type="button"
        data-ouvrir-recherche
        class="rounded border border-white/25 p-2 text-white"
        aria-label="Recherche rapide"
      >
        <span class="ms text-2xl" aria-hidden="true">search</span>
      </button>
      <button
        id="bouton-menu"
        type="button"
        class="rounded border border-white/25 p-2 text-white"
        aria-expanded="false"
        aria-controls="menu-mobile"
        aria-label="Ouvrir le menu"
      >
        <span class="ms text-2xl" aria-hidden="true">menu</span>
      </button>
    </div>
  </div>

  <div id="menu-mobile" class="hidden border-t border-white/10 bg-nuit px-5 py-4 lg:hidden">
    <nav class="flex flex-col gap-3" aria-label="Navigation mobile">
      {
        liens.map((lien) => (
          <a href={lien.href} class="py-1 font-texte text-base font-medium text-white">
            {lien.libelle}
          </a>
        ))
      }
      <a href="/scan-tva/" class="mt-2 rounded bg-or-vif px-4 py-3 text-center font-texte text-sm font-bold text-nuit">
        Scan TVA
      </a>
      <a
        href="/scan-taxe-salaires/"
        class="rounded border border-white/40 px-4 py-3 text-center font-texte text-sm font-semibold text-white"
      >
        Scan Taxe sur les salaires
      </a>
    </nav>
  </div>
</header>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ScanEngine from '@/components/scan/ScanEngine';
import SectionProrata from '@/components/scan/SectionProrata.astro';
import ParticulesOr from '@/components/scan/ParticulesOr.astro';
import { arbreTaxeSalaires } from '@/data/scan/taxeSalaires';
import { verifierArbre } from '@/data/scan/types';

const erreurs = verifierArbre(arbreTaxeSalaires);
if (erreurs.length > 0) {
  throw new Error(`Arbre taxe sur les salaires incohérent :\n${erreurs.join('\n')}`);
}
---

<BaseLayout
  titre="Scan Taxe sur les salaires, êtes-vous redevable ?"
  description="Scanner interactif : déterminez si vos rémunérations sont soumises à la taxe sur les salaires, sur quelle assiette, et comment sécuriser votre rapport d'assujettissement."
>
  <section class="projecteur relative overflow-hidden bg-nuit text-white">
    <img src="/images/scan-ts.jpg" alt="" class="kenburns absolute inset-0 h-full w-full object-cover opacity-45" aria-hidden="true" />
    <div class="absolute inset-0 bg-gradient-to-r from-nuit via-nuit/85 to-nuit/40" aria-hidden="true"></div>
    <div class="grille-nuit absolute inset-0 opacity-50" aria-hidden="true"></div>
    <span class="mot-fantome -right-4 -bottom-6 text-[6rem] md:text-[10rem]" aria-hidden="true">Salaires</span>
    <header class="relative mx-auto max-w-7xl px-5 py-12 md:px-10 md:py-16">
      <p class="etiquette text-or-vif">Scanner interactif</p>
      <h1 class="texte-affiche mt-4 max-w-3xl text-4xl text-white md:text-6xl">
        {arbreTaxeSalaires.titre}
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-7 text-white/70">{arbreTaxeSalaires.sousTitre}</p>
    </header>
  </section>
  <div class="grille-nuit relative bg-nuit">
    <ParticulesOr />
    <div class="relative mx-auto max-w-7xl px-5 py-12 md:px-10 md:py-14">
      <ScanEngine client:load arbre={arbreTaxeSalaires} />
    </div>
    <SectionProrata accent="ts" />
  </div>
</BaseLayout>

---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BandeauScan from '@/components/BandeauScan.astro';
import { noeudFaq } from '@/data/seo';

export async function getStaticPaths() {
  const definitions = await getCollection('definitions', ({ data }) => data.statut === 'publie');
  return definitions.map((definition) => ({
    params: { slug: definition.id },
    props: { entree: definition },
  }));
}

const { entree } = Astro.props;
const { Content } = await render(entree);
const toutes = (await getCollection('definitions', ({ data }) => data.statut === 'publie')).sort(
  (a, b) => a.data.ordre - b.data.ordre || a.data.terme.localeCompare(b.data.terme, 'fr')
);
const autres = toutes.filter((d) => d.id !== entree.id);

const noeudFaqPage = noeudFaq(entree.body ?? '');
const donneesStructurees = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      name: entree.data.titre,
      inLanguage: 'fr-FR',
      url: new URL(`/definition/${entree.id}/`, Astro.site).toString(),
      ...(entree.data.datePublication ? { datePublished: entree.data.datePublication.toISOString().slice(0, 10) } : {}),
      ...(entree.data.dateMaj ? { dateModified: entree.data.dateMaj.toISOString().slice(0, 10) } : {}),
      author: { '@type': 'Person', name: 'François Ouairy', jobTitle: 'Avocat fiscaliste' },
    },
    ...(noeudFaqPage ? [noeudFaqPage] : []),
    {
      '@type': 'DefinedTerm',
      name: entree.data.terme,
      description: entree.data.description,
      inDefinedTermSet: {
        '@type': 'DefinedTermSet',
        name: 'Lexique TVA et taxe sur les salaires',
        url: new URL('/definition/', Astro.site).toString(),
      },
      url: new URL(`/definition/${entree.id}/`, Astro.site).toString(),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', Astro.site).toString() },
        { '@type': 'ListItem', position: 2, name: 'Lexique', item: new URL('/definition/', Astro.site).toString() },
        { '@type': 'ListItem', position: 3, name: entree.data.terme, item: new URL(`/definition/${entree.id}/`, Astro.site).toString() },
      ],
    },
  ],
});
---

<BaseLayout titre={entree.data.titre} description={entree.data.description}>
  <script type="application/ld+json" set:html={donneesStructurees} slot="tete" />
  <div class="barre-lecture" aria-hidden="true"></div>
  <div class="mx-auto max-w-7xl px-5 py-12 md:px-10 md:py-16">
    <nav aria-label="Fil d'Ariane" class="mb-8 text-sm text-texte-3">
      <a href="/definition/" class="hover:text-encre">Lexique</a>
      <span class="mx-2" aria-hidden="true">/</span>
      <span class="text-texte-2">{entree.data.terme}</span>
    </nav>
    <header class="max-w-3xl">
      <p class="etiquette text-or">Définition</p>
      <h1 class="mt-3 font-titres text-3xl font-bold tracking-tight md:text-4xl">{entree.data.titre}</h1>
    </header>
    <article class="prose-doctrine mt-8">
      <Content />
    </article>

    <section class="mt-12 border-t border-bordure pt-8">
      <p class="etiquette text-or">Autres définitions du lexique</p>
      <div class="mt-4 flex flex-wrap gap-2">
        {
          autres.map((d) => (
            <a
              href={`/definition/${d.id}/`}
              class="rounded-full border border-bordure px-3.5 py-1.5 text-sm font-semibold text-texte-2 transition-colors hover:border-marine hover:text-marine"
            >
              {d.data.terme}
            </a>
          ))
        }
      </div>
    </section>
    <BandeauScan />
  </div>
</BaseLayout>

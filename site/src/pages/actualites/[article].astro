---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BandeauScan from '@/components/BandeauScan.astro';

export async function getStaticPaths() {
  const articles = await getCollection('actualites', ({ data }) => data.statut === 'publie');
  return articles.map((article) => ({
    params: { article: article.id },
    props: { entree: article },
  }));
}

const { entree } = Astro.props;
const { Content } = await render(entree);
const formateurDate = new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long' });

const donneesStructurees = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: entree.data.titre,
  description: entree.data.description,
  inLanguage: 'fr-FR',
  mainEntityOfPage: new URL(`/actualites/${entree.id}/`, Astro.site).toString(),
  datePublished: entree.data.date.toISOString().slice(0, 10),
  dateModified: entree.data.date.toISOString().slice(0, 10),
  author: { '@type': 'Person', name: 'François Ouairy', jobTitle: 'Avocat fiscaliste', url: new URL('/expert/', Astro.site).toString() },
  publisher: { '@type': 'Organization', name: 'BENSAID AVOCATS', url: 'https://www.bensaid-avocats.fr' },
});
---

<BaseLayout titre={entree.data.titre} description={entree.data.description}>
  <script type="application/ld+json" set:html={donneesStructurees} slot="tete" />
  <div class="mx-auto max-w-7xl px-5 py-12 md:px-10 md:py-16">
    <nav aria-label="Fil d'Ariane" class="mb-8 text-sm text-texte-3">
      <a href="/actualites/" class="hover:text-encre">Actualités</a>
    </nav>
    <header class="max-w-3xl">
      <div class="flex flex-wrap items-center gap-3">
        <time datetime={entree.data.date.toISOString()} class="etiquette text-texte-3">
          {formateurDate.format(entree.data.date)}
        </time>
        {
          entree.data.themes.map((theme) => (
            <span class="etiquette rounded bg-fond-3 px-2 py-0.5 text-texte-2">{theme}</span>
          ))
        }
      </div>
      <h1 class="mt-4 font-titres text-3xl font-bold leading-tight tracking-tight md:text-4xl">
        {entree.data.titre}
      </h1>
    </header>
    <article class="prose-doctrine mt-10">
      <Content />
    </article>
    <BandeauScan />
  </div>
</BaseLayout>

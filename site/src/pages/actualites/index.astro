---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

const articles = (await getCollection('actualites', ({ data }) => data.statut === 'publie')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const formateurDate = new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long' });
---

<BaseLayout
  titre="Actualités TVA et taxe sur les salaires"
  description="Jurisprudence, doctrine administrative, textes : l'actualité de la TVA des opérateurs partiellement exonérés et de la taxe sur les salaires, analysée par un avocat fiscaliste."
>
  <div class="mx-auto max-w-7xl px-5 py-12 md:px-10 md:py-16">
    <header class="max-w-3xl">
      <p class="etiquette text-or">Fil d'actualité</p>
      <h1 class="mt-3 font-titres text-3xl font-bold tracking-tight md:text-4xl">
        L'actualité de la TVA et de la taxe sur les salaires
      </h1>
      <p class="mt-4 text-base leading-7 text-texte-2">
        Décisions, rescrits, doctrine administrative et textes nouveaux : nous suivons ce qui
        change pour les opérateurs partiellement exonérés, et ce que cela implique concrètement.
      </p>
    </header>

    <div class="mt-12 space-y-5">
      {
        articles.map((article) => (
          <a
            href={`/actualites/${article.id}/`}
            class="group block rounded border border-bordure bg-carte p-6 transition-all hover:-translate-y-0.5 hover:shadow-ambiante-2 md:p-7"
          >
            <div class="flex flex-wrap items-center gap-3">
              <time datetime={article.data.date.toISOString()} class="etiquette text-texte-3">
                {formateurDate.format(article.data.date)}
              </time>
              {article.data.themes.map((theme) => (
                <span class="etiquette rounded bg-fond-3 px-2 py-0.5 text-texte-2">{theme}</span>
              ))}
            </div>
            <h2 class="mt-3 font-titres text-xl font-semibold leading-snug group-hover:text-marine">
              {article.data.titre}
            </h2>
            <p class="mt-2 max-w-3xl text-sm leading-6 text-texte-2">{article.data.description}</p>
          </a>
        ))
      }
      {
        articles.length === 0 && (
          <p class="rounded border border-bordure bg-fond-2 p-6 text-sm text-texte-2">
            Les premières analyses arrivent bientôt.
          </p>
        )
      }
    </div>
  </div>
</BaseLayout>

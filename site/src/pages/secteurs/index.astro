---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { imagesSecteurs } from '@/data/images';

const entrees = await getCollection('secteurs', ({ data }) => data.statut === 'publie');
const secteurs = entrees
  .filter((e) => e.data.rubrique === 'secteur' && !e.id.includes('/'))
  .sort((a, b) => a.data.ordre - b.data.ordre);
const articles = entrees
  .filter((e) => e.data.rubrique === 'article')
  .sort((a, b) => a.data.ordre - b.data.ordre);
const notions = (await getCollection('doctrine', ({ data }) => data.statut === 'publie')).sort(
  (a, b) => a.data.ordre - b.data.ordre
);
---

<BaseLayout
  titre="Doctrine par secteur — TVA et taxe sur les salaires de votre activité"
  description="Holdings, banques, assurance, immobilier, organismes sans but lucratif… Retrouvez la TVA et la taxe sur les salaires de votre secteur, expliquées par un avocat fiscaliste."
>
  <div class="mx-auto max-w-7xl px-5 py-12 md:px-10 md:py-16">
    <header class="max-w-3xl">
      <p class="etiquette text-or">Doctrine par secteur</p>
      <h1 class="mt-3 font-titres text-3xl font-bold tracking-tight md:text-4xl">
        La TVA et la taxe sur les salaires de votre activité
      </h1>
      <p class="mt-4 text-base leading-7 text-texte-2">
        Les règles de TVA ne se lisent jamais dans l'absolu : elles s'appliquent à un secteur, à
        ses flux et à ses contrats. Chaque page ci-dessous reprend, pour une activité donnée, le
        champ d'application, les exonérations, le droit à déduction et la taxe sur les salaires.
      </p>
    </header>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        secteurs.map((secteur, indice) => (
          <a
            href={`/${secteur.id}/`}
            class="reveler group overflow-hidden rounded border border-bordure bg-carte transition-all hover:-translate-y-0.5 hover:border-marine hover:shadow-ambiante-2"
            style={`transition-delay: ${(indice % 3) * 90}ms`}
          >
            {imagesSecteurs[secteur.id] && (
              <div class="relative aspect-[16/9] overflow-hidden bg-nuit">
                <img
                  src={imagesSecteurs[secteur.id]}
                  alt=""
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-nuit/70 via-transparent to-transparent"></div>
                <span class="ms absolute bottom-3 left-4 text-2xl text-or-pale" aria-hidden="true">
                  {secteur.data.pictogramme}
                </span>
              </div>
            )}
            <div class="p-6">
              {!imagesSecteurs[secteur.id] && (
                <span class="ms text-3xl text-marine" aria-hidden="true">
                  {secteur.data.pictogramme}
                </span>
              )}
              <h2 class="mt-1 font-titres text-lg font-semibold group-hover:text-marine">
                {secteur.data.titreCourt}
              </h2>
              <p class="mt-2 text-sm leading-6 text-texte-2">{secteur.data.accroche}</p>
            </div>
          </a>
        ))
      }
    </div>

    <section class="mt-16 border-t border-bordure pt-12">
      <p class="etiquette text-or">Études et articles</p>
      <h2 class="mt-3 font-titres text-2xl font-semibold">Questions particulières</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          articles.map((article) => (
            <a
              href={`/${article.id}/`}
              class="reveler group flex items-start gap-3 rounded border border-bordure bg-carte p-4 transition-colors hover:border-marine"
            >
              <span class="ms text-xl text-or" aria-hidden="true">
                {article.data.pictogramme}
              </span>
              <span>
                <h3 class="font-titres text-sm font-semibold leading-snug group-hover:text-marine">
                  {article.data.titreCourt}
                </h3>
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="mt-16 border-t border-bordure pt-12">
      <p class="etiquette text-or">Notions transversales</p>
      <h2 class="mt-3 font-titres text-2xl font-semibold">Les fondamentaux, quel que soit le secteur</h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-2">
        {
          notions.map((notion) => (
            <a
              href={`/doctrine/${notion.id}/`}
              class="reveler group flex items-start gap-4 rounded border border-bordure bg-fond-2 p-5 transition-colors hover:border-marine"
            >
              <span class="ms text-2xl text-or" aria-hidden="true">
                {notion.data.pictogramme}
              </span>
              <span>
                <h3 class="font-titres text-base font-semibold group-hover:text-marine">
                  {notion.data.titreCourt}
                </h3>
                <p class="mt-1 text-sm leading-6 text-texte-2">{notion.data.description}</p>
              </span>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

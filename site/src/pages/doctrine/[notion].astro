---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BandeauScan from '@/components/BandeauScan.astro';

export async function getStaticPaths() {
  const notions = await getCollection('doctrine', ({ data }) => data.statut === 'publie');
  return notions.map((notion) => ({
    params: { notion: notion.id },
    props: { entree: notion },
  }));
}

const { entree } = Astro.props;
const { Content } = await render(entree);

const donneesStructurees = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: entree.data.titre,
      description: entree.data.description,
      inLanguage: 'fr-FR',
      mainEntityOfPage: new URL(`/doctrine/${entree.id}/`, Astro.site).toString(),
      ...(entree.data.datePublication ? { datePublished: entree.data.datePublication.toISOString().slice(0, 10) } : {}),
      ...(entree.data.dateMaj ? { dateModified: entree.data.dateMaj.toISOString().slice(0, 10) } : {}),
      author: { '@type': 'Person', name: 'François Ouairy', jobTitle: 'Avocat fiscaliste', url: new URL('/expert/', Astro.site).toString() },
      publisher: { '@type': 'Organization', name: 'BENSAID AVOCATS', url: 'https://www.bensaid-avocats.fr' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', Astro.site).toString() },
        { '@type': 'ListItem', position: 2, name: 'Doctrine', item: new URL('/secteurs/', Astro.site).toString() },
        { '@type': 'ListItem', position: 3, name: entree.data.titreCourt, item: new URL(`/doctrine/${entree.id}/`, Astro.site).toString() },
      ],
    },
  ],
});
---

<BaseLayout titre={entree.data.titre} description={entree.data.description}>
  <script type="application/ld+json" set:html={donneesStructurees} slot="tete" />
  <div class="barre-lecture" aria-hidden="true"></div>
  <div class="mx-auto max-w-7xl px-5 py-12 md:px-10 md:py-16">
    <nav aria-label="Fil d'Ariane" class="mb-8 text-sm text-texte-3">
      <a href="/secteurs/" class="hover:text-encre">Doctrine</a>
      <span class="mx-2" aria-hidden="true">/</span>
      <span class="text-texte-2">{entree.data.titreCourt}</span>
    </nav>
    <header class="max-w-3xl">
      <p class="etiquette text-or">Notion transversale</p>
      <h1 class="mt-3 font-titres text-3xl font-bold tracking-tight md:text-4xl">
        {entree.data.titre}
      </h1>
      <p class="mt-4 text-lg leading-8 text-texte-2">{entree.data.description}</p>
    </header>
    <article class="prose-doctrine mt-10">
      <Content />
    </article>
    <BandeauScan />
  </div>
</BaseLayout>

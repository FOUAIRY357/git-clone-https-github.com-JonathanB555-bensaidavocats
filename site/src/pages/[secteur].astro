---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BandeauScan from '@/components/BandeauScan.astro';

export async function getStaticPaths() {
  const secteurs = await getCollection('secteurs', ({ data }) => data.statut === 'publie');
  return secteurs.map((secteur) => ({
    params: { secteur: secteur.id },
    props: { entree: secteur },
  }));
}

const { entree } = Astro.props;
const { Content } = await render(entree);
---

<BaseLayout titre={entree.data.titre} description={entree.data.description}>
  <div class="mx-auto max-w-7xl px-5 py-12 md:px-10 md:py-16">
    <nav aria-label="Fil d'Ariane" class="mb-8 text-sm text-texte-3">
      <a href="/secteurs/" class="hover:text-encre">Secteurs</a>
      <span class="mx-2" aria-hidden="true">/</span>
      <span class="text-texte-2">{entree.data.titreCourt}</span>
    </nav>
    <header class="max-w-3xl">
      <p class="etiquette text-or">Doctrine sectorielle</p>
      <h1 class="mt-3 font-titres text-3xl font-bold tracking-tight md:text-4xl">
        {entree.data.titre}
      </h1>
      <p class="mt-4 text-lg leading-8 text-texte-2">{entree.data.accroche}</p>
    </header>
    <article class="prose-doctrine mt-10">
      <Content />
    </article>
    <BandeauScan />
  </div>
</BaseLayout>

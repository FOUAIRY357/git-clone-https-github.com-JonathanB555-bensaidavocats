---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BandeauScan from '@/components/BandeauScan.astro';
import { imagesSecteurs } from '@/data/images';

export async function getStaticPaths() {
  const secteurs = await getCollection('secteurs', ({ data }) => data.statut === 'publie');
  return secteurs.map((secteur) => ({
    params: { secteur: secteur.id },
    props: { entree: secteur },
  }));
}

const { entree } = Astro.props;
const { Content } = await render(entree);

// Sous-pages directes de cette rubrique et rubrique parente éventuelle.
const toutes = await getCollection('secteurs', ({ data }) => data.statut === 'publie');
const sousPages = toutes
  .filter((e) => e.id.startsWith(entree.id + '/'))
  .sort((a, b) => a.data.ordre - b.data.ordre);
const parent = entree.id.includes('/')
  ? toutes.find((e) => e.id === entree.id.split('/').slice(0, -1).join('/'))
  : undefined;
const imageBanniere = entree.id.includes('/') ? undefined : imagesSecteurs[entree.id];

// Navigation guidée : page précédente / suivante au sein du même ensemble
// (sous-pages d'une même rubrique, ou pages de même niveau et de même rubrique).
const freres = (
  parent
    ? toutes.filter((e) => e.id.startsWith(parent.id + '/') && !e.id.slice(parent.id.length + 1).includes('/'))
    : toutes.filter((e) => !e.id.includes('/') && e.data.rubrique === entree.data.rubrique)
).sort((a, b) => a.data.ordre - b.data.ordre || a.data.titreCourt.localeCompare(b.data.titreCourt, 'fr'));
const position = freres.findIndex((e) => e.id === entree.id);
const precedente = position > 0 ? freres[position - 1] : undefined;
const suivante = position >= 0 && position < freres.length - 1 ? freres[position + 1] : undefined;
const libelleEnsemble = parent
  ? parent.data.titreCourt
  : entree.data.rubrique === 'article'
    ? 'Guides TVA'
    : 'Secteurs';
const urlEnsemble = parent ? `/${parent.id}/` : '/secteurs/';
---

<BaseLayout titre={entree.data.titre} description={entree.data.description}>
  {
    imageBanniere && (
      <section class="relative overflow-hidden bg-nuit text-white">
        <img src={imageBanniere} alt="" transition:name={'img-' + entree.id} class="kenburns absolute inset-0 h-full w-full object-cover opacity-50" aria-hidden="true" />
        <div class="absolute inset-0 bg-gradient-to-r from-nuit via-nuit/80 to-nuit/30" aria-hidden="true" />
        <div class="relative mx-auto max-w-7xl px-5 py-14 md:px-10 md:py-20">
          <p class="etiquette text-or-vif">Doctrine sectorielle</p>
          <h1 class="texte-affiche mt-4 max-w-3xl text-4xl text-white md:text-6xl">{entree.data.titre}</h1>
        </div>
      </section>
    )
  }
  <div class="mx-auto max-w-7xl px-5 py-12 md:px-10 md:py-16">
    <nav aria-label="Fil d'Ariane" class="mb-8 text-sm text-texte-3">
      <a href="/secteurs/" class="hover:text-encre">Secteurs</a>
      {
        parent && (
          <>
            <span class="mx-2" aria-hidden="true">/</span>
            <a href={`/${parent.id}/`} class="hover:text-encre">{parent.data.titreCourt}</a>
          </>
        )
      }
      <span class="mx-2" aria-hidden="true">/</span>
      <span class="text-texte-2">{entree.data.titreCourt}</span>
    </nav>
    <header class="max-w-3xl">
      {
        !imageBanniere && (
          <>
            <p class="etiquette text-or">Doctrine sectorielle</p>
            <h1 class="mt-3 font-titres text-3xl font-bold tracking-tight md:text-4xl">
              {entree.data.titre}
            </h1>
          </>
        )
      }
      <p class="mt-4 text-lg leading-8 text-texte-2">{entree.data.accroche}</p>
    </header>
    <article class="prose-doctrine mt-10">
      <Content />
    </article>
    {
      sousPages.length > 0 && (
        <section class="mt-12 border-t border-bordure pt-8">
          <p class="etiquette text-or">Dans cette rubrique</p>
          <div class="mt-5 grid gap-4 sm:grid-cols-2">
            {sousPages.map((page, indice) => (
              <a
                href={`/${page.id}/`}
                class="reveler group rounded border border-bordure bg-carte p-5 transition-all hover:-translate-y-0.5 hover:border-marine hover:shadow-ambiante-2"
                style={`transition-delay: ${(indice % 2) * 90}ms`}
              >
                <h2 class="font-titres text-base font-semibold group-hover:text-marine">
                  {page.data.titreCourt}
                </h2>
                <p class="mt-1.5 text-sm leading-6 text-texte-2">{page.data.description}</p>
              </a>
            ))}
          </div>
        </section>
      )
    }
    {
      (precedente || suivante) && (
        <nav class="mt-12 grid gap-4 border-t border-bordure pt-8 sm:grid-cols-2" aria-label="Continuer la lecture">
          {precedente ? (
            <a
              href={`/${precedente.id}/`}
              class="group rounded border border-bordure bg-carte p-5 transition-all hover:-translate-y-0.5 hover:border-marine hover:shadow-ambiante-2"
            >
              <p class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wide text-texte-3">
                <span class="ms text-base" aria-hidden="true">arrow_back</span>
                Précédent · {libelleEnsemble}
              </p>
              <p class="mt-2 font-titres text-base font-semibold group-hover:text-marine">{precedente.data.titreCourt}</p>
            </a>
          ) : (
            <a
              href={urlEnsemble}
              class="group rounded border border-dashed border-bordure p-5 transition-colors hover:border-marine"
            >
              <p class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wide text-texte-3">
                <span class="ms text-base" aria-hidden="true">arrow_back</span>
                Revenir à l'ensemble
              </p>
              <p class="mt-2 font-titres text-base font-semibold group-hover:text-marine">{libelleEnsemble}</p>
            </a>
          )}
          {suivante && (
            <a
              href={`/${suivante.id}/`}
              class="group rounded border border-bordure bg-carte p-5 text-right transition-all hover:-translate-y-0.5 hover:border-marine hover:shadow-ambiante-2"
            >
              <p class="flex items-center justify-end gap-1.5 text-xs font-semibold uppercase tracking-wide text-texte-3">
                Suivant · {libelleEnsemble}
                <span class="ms text-base" aria-hidden="true">arrow_forward</span>
              </p>
              <p class="mt-2 font-titres text-base font-semibold group-hover:text-marine">{suivante.data.titreCourt}</p>
            </a>
          )}
        </nav>
      )
    }
    <BandeauScan />
  </div>
</BaseLayout>

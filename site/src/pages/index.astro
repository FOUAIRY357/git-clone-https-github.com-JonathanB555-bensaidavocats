---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { imagesSecteurs } from '@/data/images';

const secteurs = (
  await getCollection(
    'secteurs',
    ({ id, data }) => data.statut === 'publie' && data.rubrique === 'secteur' && !id.includes('/')
  )
)
  .sort((a, b) => a.data.ordre - b.data.ordre)
  .slice(0, 6);
const actualites = (await getCollection('actualites', ({ data }) => data.statut === 'publie'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const formateurDate = new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long' });

const etapes = [
  {
    icone: 'quiz',
    titre: 'Répondez à quelques questions',
    texte:
      "Le scanner déroule la logique du Code général des impôts : champ d'application, exonérations, options, droit à déduction.",
  },
  {
    icone: 'menu_book',
    titre: 'Chaque question renvoie à la doctrine',
    texte:
      "Un doute ? Chaque étape est adossée à sa base légale et à nos pages d'explication. Répondez « je ne sais pas » et approfondissez.",
  },
  {
    icone: 'workspace_premium',
    titre: 'Obtenez une qualification motivée',
    texte:
      "Le scan conclut sur la qualification de l'opération, ses conséquences sur vos droits à déduction et les points à sécuriser avec un expert.",
  },
];

const donneesStructurees = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'Taxe sur les Salaires & TVA',
      url: 'https://taxesalaire.com/',
      inLanguage: 'fr-FR',
      description:
        "Site de référence sur la TVA des opérateurs partiellement exonérés et la taxe sur les salaires, édité par le cabinet BENSAID AVOCATS.",
    },
    {
      '@type': 'LegalService',
      name: 'BENSAID AVOCATS',
      url: 'https://www.bensaid-avocats.fr',
      areaServed: 'FR',
      knowsAbout: ['TVA', 'Taxe sur les salaires', 'Droit fiscal'],
    },
  ],
});
---

<BaseLayout
  titre="Taxe sur les Salaires & TVA, scanners interactifs et doctrine par secteur"
  description="Scanners interactifs et doctrine par le cabinet BENSAID AVOCATS : taxabilité de vos opérations, droit à déduction de TVA, taxe sur les salaires."
  titreBrut
>
  <script type="application/ld+json" set:html={donneesStructurees} slot="tete" />

  <!-- Héros nuit -->
  <section class="projecteur relative overflow-hidden bg-nuit text-white">
    <div class="parallaxe absolute inset-0" aria-hidden="true">
    <img
      src="/images/accueil-hero.jpg"
      alt=""
      class="kenburns absolute inset-0 h-full w-full object-cover object-right opacity-70"
      fetchpriority="high"
      aria-hidden="true"
    />
    <video
      class="video-hero absolute inset-0 hidden h-full w-full object-cover object-right opacity-70 md:block"
      autoplay
      muted
      loop
      playsinline
      poster="/images/accueil-hero.jpg"
      aria-hidden="true"
    >
      <source src="/videos/accueil-hero.mp4" type="video/mp4" />
    </video>
    </div>
    <div
      class="absolute inset-0"
      style="background: linear-gradient(90deg, rgba(5,13,26,0.96) 0%, rgba(5,13,26,0.82) 42%, rgba(5,13,26,0.25) 75%, rgba(5,13,26,0.55) 100%), linear-gradient(0deg, rgba(5,13,26,0.85) 0%, transparent 30%);"
      aria-hidden="true"
    >
    </div>
    <div class="grille-nuit absolute inset-0 opacity-60" aria-hidden="true"></div>
    <span class="mot-fantome -right-8 bottom-2 text-[9rem] md:text-[15rem]" aria-hidden="true">TVA</span>


    <div class="relative mx-auto max-w-7xl px-5 py-20 md:px-10 md:py-28">
      <div class="max-w-3xl">
        <p class="etiquette apparition text-or-vif">TVA · Taxe sur les salaires · Droit à déduction</p>
        <h1 class="texte-affiche apparition mt-5 text-5xl text-white md:text-7xl">
          Scannez vos opérations.<br />
          <span class="text-or-vif">Récupérez votre TVA.</span>
        </h1>
        <p class="apparition-lente mt-7 max-w-xl text-lg leading-8 text-white/70">
          Le scanner déroule le raisonnement d'un avocat fiscaliste : champ d'application,
          exonérations, options, droit à déduction. Votre cartographie se construit en direct,
          le rapport tombe à la fin.
        </p>
        <div class="apparition-lente mt-10 flex flex-col gap-3 sm:flex-row">
          <a
            href="/scan-tva/"
            class="flex items-center justify-center gap-2 rounded bg-or-vif px-7 py-4 font-texte text-base font-bold text-nuit transition-all hover:-translate-y-0.5 hover:bg-or-pale"
          >
            <span class="ms text-xl" aria-hidden="true">radar</span>
            Lancer le Scan TVA
          </a>
          <a
            href="/scan-taxe-salaires/"
            class="flex items-center justify-center gap-2 rounded border border-white/40 px-7 py-4 font-texte text-base font-semibold text-white transition-colors hover:border-white hover:bg-white/10"
          >
            <span class="ms text-xl" aria-hidden="true">badge</span>
            Scan Taxe sur les salaires
          </a>
        </div>
        <p class="mt-5 text-sm text-white/50">Gratuit, sans inscription. Vos réponses restent dans votre navigateur.</p>
      </div>
    </div>
  </section>

  <!-- Bandeau défilant -->
  <div class="overflow-hidden border-y border-nuit/10 bg-or-vif py-3 text-nuit" aria-hidden="true">
    <div class="defilement">
      {
        [0, 1].map(() => (
          <div class="flex items-center gap-10 pr-10">
            {[
              '16,2 milliards d’euros de taxe sur les salaires collectés en 2022',
              'Deux scanners interactifs',
              'Holdings · Banque · Assurance · Immobilier · Santé · OSBL',
              'Une doctrine opérationnelle, adossée au CGI et au BOFiP',
              'Par le cabinet BENSAID AVOCATS',
            ].map((element) => (
              <span class="flex items-center gap-10 whitespace-nowrap font-titres text-sm font-bold uppercase tracking-wide">
                {element}
                <span class="text-nuit/40">◆</span>
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <!-- Chiffres clés -->
  <section class="border-b border-bordure bg-fond">
    <div class="mx-auto max-w-7xl px-5 pt-12 md:px-10 md:pt-14">
      <p class="etiquette reveler text-or">Les chiffres clés</p>
    </div>
    <div class="mx-auto grid max-w-7xl grid-cols-2 gap-8 px-5 py-10 md:grid-cols-4 md:px-10 md:pb-14">
      {
        [
          { valeur: 207.8, decimales: 1, suffixe: 'Md€', libelle: 'de TVA collectée en France en 2024 : la première recette fiscale (INSEE)' },
          { valeur: 16.2, decimales: 1, suffixe: 'Md€', libelle: 'de taxe sur les salaires collectés en 2022' },
          { valeur: 90, decimales: 0, suffixe: '%', libelle: 'le seuil d’assujettissement à surveiller chaque année' },
          { valeur: 3, decimales: 0, suffixe: 'coefficients', libelle: 'décident de chaque euro de TVA récupéré' },
        ].map((chiffre, indice) => (
          <div class="reveler" style={`transition-delay: ${indice * 90}ms`}>
            <p class="texte-affiche text-4xl text-marine md:text-5xl">
              <span data-compteur={chiffre.valeur} data-decimales={chiffre.decimales}>0</span>
              <span class="text-or"> {chiffre.suffixe}</span>
            </p>
            <p class="mt-2 text-sm leading-5 text-texte-2">{chiffre.libelle}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Comment ça marche -->
  <section class="border-b border-bordure bg-fond-2">
    <div class="mx-auto max-w-7xl px-5 py-14 md:px-10 md:py-20">
      <p class="etiquette text-or">Comment fonctionne le scan</p>
      <h2 class="mt-3 max-w-xl font-titres text-2xl font-semibold md:text-3xl">
        Un raisonnement d'avocat fiscaliste, pas un questionnaire générique.
      </h2>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {
          etapes.map((etape, index) => (
            <article class="reveler rounded border border-bordure bg-carte p-6 shadow-ambiante" style={`transition-delay: ${index * 90}ms`}>
              <div class="flex items-center justify-between">
                <span class="ms text-3xl text-or" aria-hidden="true">
                  {etape.icone}
                </span>
                <span class="font-titres text-sm font-bold text-texte-3">0{index + 1}</span>
              </div>
              <h3 class="mt-4 font-titres text-lg font-semibold">{etape.titre}</h3>
              <p class="mt-2 text-sm leading-6 text-texte-2">{etape.texte}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Secteurs -->
  <section class="border-b border-bordure">
    <div class="mx-auto max-w-7xl px-5 py-14 md:px-10 md:py-20">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="etiquette text-or">Doctrine par secteur</p>
          <h2 class="mt-3 font-titres text-2xl font-semibold md:text-3xl">
            La TVA et la taxe sur les salaires de votre activité
          </h2>
        </div>
        <a href="/secteurs/" class="text-sm font-semibold text-lien underline underline-offset-4">
          Tous les secteurs
        </a>
      </div>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          secteurs.map((secteur, indice) => (
            <a
              href={`/${secteur.id}/`}
              class="reveler group overflow-hidden rounded border border-bordure bg-carte transition-all hover:-translate-y-0.5 hover:border-marine hover:shadow-ambiante-2"
              style={`transition-delay: ${(indice % 3) * 90}ms`}
            >
              {imagesSecteurs[secteur.id] && (
                <div class="relative aspect-[16/9] overflow-hidden bg-nuit">
                  <img
                    src={imagesSecteurs[secteur.id]}
                    alt=""
                    loading="lazy"
                    transition:name={'img-' + secteur.id}
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-nuit/70 via-transparent to-transparent"></div>
                  <span class="ms absolute bottom-3 left-4 text-2xl text-or-pale" aria-hidden="true">
                    {secteur.data.pictogramme}
                  </span>
                </div>
              )}
              <div class="p-6">
                {!imagesSecteurs[secteur.id] && (
                  <span class="ms text-3xl text-marine" aria-hidden="true">
                    {secteur.data.pictogramme}
                  </span>
                )}
                <h3 class="mt-1 font-titres text-lg font-semibold group-hover:text-marine">
                  {secteur.data.titreCourt}
                </h3>
                <p class="mt-2 text-sm leading-6 text-texte-2">{secteur.data.accroche}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Actualités -->
  <section class="border-b border-bordure bg-fond-2">
    <div class="mx-auto max-w-7xl px-5 py-14 md:px-10 md:py-20">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="etiquette text-or">Fil d'actualité</p>
          <h2 class="mt-3 font-titres text-2xl font-semibold md:text-3xl">Dernières analyses</h2>
        </div>
        <a href="/actualites/" class="text-sm font-semibold text-lien underline underline-offset-4">
          Toute l'actualité
        </a>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {
          actualites.map((article, indice) => (
            <a
              href={`/actualites/${article.id}/`}
              class="reveler group rounded border border-bordure bg-carte p-6 transition-all hover:-translate-y-0.5 hover:shadow-ambiante-2"
              style={`transition-delay: ${indice * 90}ms`}
            >
              <time datetime={article.data.date.toISOString()} class="etiquette text-texte-3">
                {formateurDate.format(article.data.date)}
              </time>
              <h3 class="mt-3 font-titres text-base font-semibold leading-snug group-hover:text-marine">
                {article.data.titre}
              </h3>
              <p class="mt-2 text-sm leading-6 text-texte-2">{article.data.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- L'expert -->
  <section class="projecteur relative overflow-hidden bg-nuit text-white">
    <span class="mot-fantome -left-6 -top-4 text-[7rem] md:text-[11rem]" aria-hidden="true">Expert</span>
    <div class="relative mx-auto max-w-7xl px-5 py-14 md:px-10 md:py-20">
      <div class="grid items-center gap-10 md:grid-cols-[1.4fr_1fr]">
        <div>
          <p class="etiquette text-or-pale">L'expert derrière le site</p>
          <h2 class="mt-3 font-titres text-2xl font-semibold text-white md:text-3xl">
            François Ouairy, avocat fiscaliste
          </h2>
          <p class="mt-4 max-w-xl text-base leading-7 text-white/80">
            Ce site est édité par le cabinet BENSAID AVOCATS. François Ouairy y accompagne les
            opérateurs partiellement exonérés, holdings, banques, assureurs, acteurs de
            l'immobilier, de la santé et du non-lucratif, sur la TVA, le droit à déduction et la
            taxe sur les salaires.
          </p>
          <a
            href="/expert/"
            class="mt-7 inline-flex items-center gap-2 rounded bg-white px-6 py-3 font-texte text-sm font-semibold text-marine transition-colors hover:bg-or-pale"
          >
            Rencontrer l'expert
            <span class="ms text-lg" aria-hidden="true">arrow_forward</span>
          </a>
        </div>
        <div class="rounded border border-white/15 bg-white/5 p-6">
          <p class="etiquette text-or-pale">Quand consulter ?</p>
          <ul class="mt-4 space-y-3 text-sm leading-6 text-white/85">
            <li class="flex gap-3">
              <span class="mt-2.5 h-px w-3.5 shrink-0 bg-or-pale" aria-hidden="true"></span>
              Un scan conclut à une qualification incertaine ou défavorable.
            </li>
            <li class="flex gap-3">
              <span class="mt-2.5 h-px w-3.5 shrink-0 bg-or-pale" aria-hidden="true"></span>
              Votre prorata ou votre rapport d'assujettissement mérite un audit.
            </li>
            <li class="flex gap-3">
              <span class="mt-2.5 h-px w-3.5 shrink-0 bg-or-pale" aria-hidden="true"></span>
              Vous faites l'objet d'un contrôle ou d'une proposition de rectification.
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

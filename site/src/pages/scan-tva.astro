---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ScanEngine from '@/components/scan/ScanEngine';
import { arbreTva } from '@/data/scan/tva';
import { verifierArbre } from '@/data/scan/types';

const erreurs = verifierArbre(arbreTva);
if (erreurs.length > 0) {
  throw new Error(`Arbre TVA incohérent :\n${erreurs.join('\n')}`);
}
---

<BaseLayout
  titre="Scan TVA — déterminez la taxabilité de vos opérations"
  description="Scanner interactif : qualifiez une opération au regard de la TVA (champ d'application, exonérations, options, assimilations) et mesurez son incidence sur votre droit à déduction."
>
  <section class="relative overflow-hidden bg-nuit text-white">
    <img src="/images/scan-tva.jpg" alt="" class="absolute inset-0 h-full w-full object-cover opacity-45" aria-hidden="true" />
    <div class="absolute inset-0 bg-gradient-to-r from-nuit via-nuit/85 to-nuit/40" aria-hidden="true"></div>
    <div class="grille-nuit absolute inset-0 opacity-50" aria-hidden="true"></div>
    <span class="mot-fantome -right-4 -bottom-6 text-[6rem] md:text-[10rem]" aria-hidden="true">Scan</span>
    <header class="relative mx-auto max-w-7xl px-5 py-12 md:px-10 md:py-16">
      <p class="etiquette text-or-vif">Scanner interactif</p>
      <h1 class="texte-affiche mt-4 max-w-3xl text-4xl text-white md:text-6xl">{arbreTva.titre}</h1>
      <p class="mt-5 max-w-2xl text-base leading-7 text-white/70">{arbreTva.sousTitre}</p>
    </header>
  </section>
  <div class="mx-auto max-w-7xl px-5 py-12 md:px-10 md:py-14">
    <ScanEngine client:load arbre={arbreTva} dossier />
  </div>
</BaseLayout>

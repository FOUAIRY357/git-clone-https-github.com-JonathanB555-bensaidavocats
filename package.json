{
  "name": "piste-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for French legal APIs (Légifrance + Judilibre Cour de cassation + Conseil d'État) via PISTE",
  "type": "module",
  "bin": {
    "piste-mcp": "src/index.ts"
  },
  "scripts": {
